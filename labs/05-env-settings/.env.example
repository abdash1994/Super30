# Copy to .env (never committed) or export these in your shell / deployment platform.
APP_ENV=dev                 # dev | test | prod
DATABASE_URL=               # required in prod, e.g. postgresql://app:CHANGE_ME@db.internal:5432/app
SECRET_KEY=                 # required in prod, at least 32 characters
DEBUG=                      # true | false; must be false in prod
LOG_LEVEL=                  # DEBUG | INFO | WARNING | ERROR
# FAKE_DATA=false           # only allowed to be true when APP_ENV=test
